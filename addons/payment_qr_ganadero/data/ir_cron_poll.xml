<?xml version="1.0" encoding="utf-8"?>
<!-- Scheduled cron job to poll pending Banco Ganadero QR payments every 2 minutes (Point 5). -->
<odoo>
    <!-- Fallback poller: confirms recent pending QR Ganadero transactions if webhook was missed. -->
    <record id="ir_cron_qr_ganadero_poll" model="ir.cron">
        <field name="name">QR Banco Ganadero: poll pending payments</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_qr_ganadero_poll_pending()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

