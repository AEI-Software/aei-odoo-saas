<?xml version="1.0" encoding="utf-8"?>
<!-- Payment method, accounting payment method, and provider records for QR Banco Ganadero. -->
<odoo>

    <!-- Create payment.method and account.payment.method records once (noupdate=1). -->
    <data noupdate="1">
        <record id="payment_method_qr_ganadero" model="payment.method">
            <field name="name">QR Banco Ganadero</field>
            <field name="code">qr_ganadero</field>
            <field name="support_refund">none</field>
            <field name="support_tokenization" eval="False"/>
            <field name="support_express_checkout" eval="False"/>
            <field name="active" eval="True"/>
            <field name="sequence">71</field>
        </record>

        <!-- Accounting-layer inbound payment method required for bank journal reconciliation. -->
        <record id="account_payment_method_qr_ganadero_inbound" model="account.payment.method">
            <field name="name">QR Banco Ganadero</field>
            <field name="code">qr_ganadero</field>
            <field name="payment_type">inbound</field>
        </record>
    </data>

    <!-- Initial payment.provider record in test mode (noupdate=1 so admin credentials are preserved). -->
    <data noupdate="1">
        <record id="payment_provider_qr_ganadero" model="payment.provider">
            <field name="name">QR Banco Ganadero</field>
            <field name="code">qr_ganadero</field>
            <field name="state">test</field>
            <field name="is_published">True</field>
            <field name="qr_ganadero_base_url">https://sandbox.bg.com.bo</field>
            <field name="qr_ganadero_api_key">CONFIGURAR_EN_ADMIN</field>
            <field name="qr_ganadero_api_key_header">XApi--Key</field>
            <field name="qr_ganadero_username">CONFIGURAR_EN_ADMIN</field>
            <field name="qr_ganadero_password">CONFIGURAR_EN_ADMIN</field>
            <field name="qr_ganadero_account_ref">CUENTAGANANET</field>
            <field name="qr_ganadero_bank_user">BANCOGANADERO1</field>
            <field name="payment_method_ids" eval="[(4, ref('payment_method_qr_ganadero'))]"/>
            <field name="redirect_form_view_id" ref="payment_qr_ganadero.qr_ganadero_redirect_form"/>
        </record>
    </data>

    <!-- Ensure structural links stay intact on module upgrade without overwriting credentials. -->
    <data noupdate="0">
        <record id="payment_provider_qr_ganadero" model="payment.provider">
            <field name="payment_method_ids" eval="[(4, ref('payment_method_qr_ganadero'))]"/>
            <field name="redirect_form_view_id" ref="payment_qr_ganadero.qr_ganadero_redirect_form"/>
        </record>
    </data>

</odoo>

