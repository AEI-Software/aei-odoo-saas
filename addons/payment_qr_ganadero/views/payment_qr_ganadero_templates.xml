<?xml version="1.0" encoding="utf-8"?>
<!-- QWeb redirect form and customer QR payment screen for Banco Ganadero QR Empresarial v1.17.4. -->
<odoo>

    <!-- Redirect form injected into Odoo 18 checkout DOM to navigate to /payment/qr_ganadero/display. -->
    <template id="qr_ganadero_redirect_form" name="QR Banco Ganadero - Redirect Form">
        <form
            id="o_payment_redirect_form"
            action="/payment/qr_ganadero/display"
            method="get"
        >
            <input type="hidden" name="reference" t-att-value="reference"/>
        </form>
    </template>

    <!-- Public page displaying the generated QR code, status indicator, and demo simulation button. -->
    <template id="qr_ganadero_display" name="QR Banco Ganadero - Pantalla de Pago">
        <t t-call="website.layout">
            <div class="container py-5 text-center">

                <t t-if="is_demo">
                    <div class="alert alert-warning d-inline-flex align-items-center gap-2 mb-3 fw-bold" role="alert">
                        <span>MODO DEMO — No se realiza ningún cobro real en Banco Ganadero</span>
                    </div>
                </t>

                <h2 class="mb-1">Pago con QR — Banco Ganadero</h2>
                <p class="text-muted mb-4">Escanea el código QR desde tu aplicación bancaria para completar el pago.</p>

                <t t-if="qr_image">
                    <t t-if="is_demo">
                        <img
                            t-att-src="'data:image/svg+xml;base64,' + qr_image"
                            alt="QR Banco Ganadero (DEMO)"
                            class="img-fluid border rounded p-3 shadow-sm"
                            style="max-width:280px;"
                        />
                    </t>
                    <t t-else="">
                        <img
                            t-att-src="'data:image/png;base64,' + qr_image"
                            alt="QR Banco Ganadero"
                            class="img-fluid border rounded p-3 shadow-sm"
                            style="max-width:280px;"
                        />
                    </t>
                </t>
                <t t-else="">
                    <div class="alert alert-warning d-inline-block mt-2">
                        No se pudo generar el código QR. Por favor intenta nuevamente o contacta a soporte.
                    </div>
                </t>

                <p class="mt-3 fs-5">
                    <strong t-esc="currency"/>&#160;<strong t-esc="amount"/>
                </p>
                <t t-if="qr_id">
                    <p class="text-muted small mb-1">ID QR: <code t-esc="qr_id"/></p>
                </t>
                <p class="text-muted small">Este código QR tiene vigencia de 24 horas.</p>

                <div id="qr_ganadero_status_msg" class="mt-3 alert alert-info d-inline-flex align-items-center gap-2">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"/>
                    <span>Esperando confirmación del Banco Ganadero…</span>
                </div>

                <t t-if="is_demo">
                    <div class="mt-3">
                        <button
                            id="qr_ganadero_simulate_btn"
                            class="btn btn-success btn-lg"
                            type="button"
                        >
                            Simular Pago (Demo)
                        </button>
                        <p class="text-muted small mt-1">Confirma la transacción en Odoo sin realizar un cobro bancario real.</p>
                    </div>
                </t>

                <input type="hidden" id="qr_ganadero_reference" t-att-value="reference"/>
                <input type="hidden" id="qr_ganadero_status_url" value="/payment/qr_ganadero/status"/>
                <input type="hidden" id="qr_ganadero_simulate_url" value="/payment/qr_ganadero/simulate"/>
                <input type="hidden" id="qr_ganadero_landing" t-att-value="landing_route"/>
                <input type="hidden" id="qr_ganadero_is_demo" t-att-value="'1' if is_demo else ''"/>

                <div class="mt-4 border-top pt-3">
                    <a href="/shop" class="btn btn-outline-secondary btn-sm">Volver a la tienda</a>
                </div>

            </div>
        </t>
    </template>

</odoo>

