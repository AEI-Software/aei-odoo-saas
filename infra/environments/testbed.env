# =============================================================================
# infra/environments/testbed.env — Testbed de portabilidad en cruzoil (10.9.13.2)
#
# Simula una "nube genérica": 4 VMs KVM sobre bridge br0, sin Ceph ni RadosGW.
#   k3s-test-1..3  10.9.13.21-23  (K3s servers, Longhorn)
#   pg-test-1      10.9.13.24     (Patroni single + MinIO)
#   kube-vip       10.9.13.20
#
# Uso:
#   ./infra/k3s-ha/deploy-k3s-cluster.sh infra/environments/testbed.env
#   ./infra/postgres-ha/deploy-all.sh    infra/environments/testbed.env
#   ./infra/apply-manifests.sh --env infra/environments/testbed.env
# =============================================================================

ENV_NAME="testbed"

# ─── SSH ─────────────────────────────────────────────────────────────────────
SSH_USER="ubuntu"
SSH_KEY="/home/kali/it911/pentest_it911/hardening/keys/it911_admin_ed25519"

# ─── Nodos K3s: "name:ssh_ip:internal_ip" (single-NIC: ambas IPs iguales) ────
K3S_NODES=(
  "k3s-test-1:10.9.13.21:10.9.13.21"
  "k3s-test-2:10.9.13.22:10.9.13.22"
  "k3s-test-3:10.9.13.23:10.9.13.23"
)
K3S_WORKER_NODES=()             # sin workers dedicados — los 3 servers agendan pods
KUBE_VIP_IP="10.9.13.20"
K3S_INTERFACE="enp1s0"          # verificar en la primera VM: ip -br link

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND="longhorn"
STORAGE_CLASS="longhorn"
CEPH_MON_HOSTS=""

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
PG_TOPOLOGY="single"
PG_NODES=(
  "pg-test-1:10.9.13.24:10.9.13.24"
)
PG_ENDPOINT_IPS="10.9.13.24"
PG_CHECK_IPS="10.9.13.24"
PG_NETWORK_CIDR="10.9.13.0/24"   # egress de tenants hacia HAProxy (NetworkPolicy del portal)

# ─── Backups S3 (MinIO en pg-test-1, TLS self-signed) ────────────────────────
S3_USE_STUNNEL="false"
S3_REPO_ENDPOINT="10.9.13.24:9000"             # pgBackRest directo a MinIO (verify-tls=n)
BACKUP_S3_ENDPOINT="https://10.9.13.24:9000"   # cronjobs del clúster

# ─── Dominio / ingress ───────────────────────────────────────────────────────
# Desde 2026-07-29 el testbed tiene su PROPIO tunnel cloudflared, desplegado
# in-cluster (07-cloudflare-tunnel.yaml, namespace cloudflare, 2 réplicas):
#   tunnel afc7a49a-166d-4505-92de-b9aad8fb1e32  (account 2755b41b811dc9afc...)
#   ruta comodín (config remote-managed, ya creada en Cloudflare):
#     *.aeisoftware.com → http://traefik.kube-system:80
# El token vive en CLOUDFLARE_TUNNEL_TOKEN de .secrets.env.testbed.
# Verificado 2026-07-29: https://demo1-tb.aeisoftware.com → HTTP 200 desde Odoo.
#
# ⚠️  El tunnel corre DENTRO del clúster a propósito: su servicio destino es
#     `traefik.kube-system`, un nombre DNS que solo resuelve in-cluster. Como
#     contenedor docker en el host cruzoil daría 502.
#
# ⚠️  Este tunnel es INDEPENDIENTE del tunnel del host cruzoil (contenedor
#     6ad434184e13, que sirve las cargas de terceros del host). No confundirlos:
#     correr setup_cloudflare_wildcard_tunnel.py contra el del host borraría
#     todas sus rutas.
#
# ⚠️⚠️ LÍMITE DE TLS — el Universal SSL de Cloudflare solo cubre UN nivel:
#     el certificado presenta SAN = {aeisoftware.com, *.aeisoftware.com}.
#     Un host de dos niveles como `demo1.test.aeisoftware.com` resuelve por DNS y
#     la ruta del tunnel hace match por sufijo, pero el handshake TLS muere en el
#     edge (alert 40, handshake_failure) porque ningún certificado lo cubre.
#     → Por eso el testbed usa el esquema de UN nivel, con los MISMOS dominios que
#       tenía el clúster productivo de COTAS (decisión del 2026-07-29):
#         staging.aeisoftware.com · www.aeisoftware.com · portal.aeisoftware.com
#         <tenant>.aeisoftware.com   (provisionado dinámicamente por el portal)
#       Todos estaban en 404 desde el desmantelamiento de COTAS, así que reusarlos
#       no desplaza nada. `admin.` sigue libre: su stack (06-odoo-admin.yaml) no se
#       despliega en el testbed, y www. lo sirve el Odoo de staging.
#     El esquema `*.test.aeisoftware.com` queda DESCARTADO: exigiría Advanced
#     Certificate Manager (~10 USD/mes) sin aportar nada al laboratorio.
BASE_DOMAIN="aeisoftware.com"                  # mismos dominios que el ex-productivo
WILDCARD_HOSTNAME="*.aeisoftware.com"          # ruta real del tunnel (1 nivel)
TRAEFIK_SERVICE="http://traefik.kube-system:80"
CF_TUNNEL_ID="afc7a49a-166d-4505-92de-b9aad8fb1e32"
CF_ACCOUNT_ID="2755b41b811dc9afc7396ed5d1e27644"

# ─── Manifiestos a excluir en apply-manifests.sh ─────────────────────────────
# Sin stack odoo-admin de producción.
# 05c requiere CRD ServiceMonitor (kube-prometheus, no instalado en testbed)
# 07-cloudflare-tunnel.yaml EXCLUIDO desde 2026-08-09: el tunnel comodín se
# movió a cotas-staging (mismo tunnel/token; los connectors de cruzoil quedaron
# en replicas=0). Re-aplicarlo aquí levantaría connectors duplicados compitiendo
# por el mismo tunnel con el clúster de COTAS.
MANIFEST_EXCLUDE="05c-portal-servicemonitor.yaml 06-odoo-admin.yaml 06b-odoo-admin-netpol.yaml 07-cloudflare-tunnel.yaml"
