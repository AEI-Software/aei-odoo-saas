# =============================================================================
# infra/environments/cotas-staging.env — Staging en la nube COTAS (cloudscz)
#
# Tenant OpenStack: proyecto IT911 en cloudscz.cotas.com.bo (PCD 2026.4 CE,
# DU 10.40.3.50, acceso vía VPN — ver ~/it911/cloud.cotas.com/ACCESS.md).
# Creado 2026-08-09: primer entorno de la NUEVA arquitectura
# (docs/CLOUD-STRATEGY-2026-08.md): Longhorn thin-provisioned re-tuneado,
# Postgres POR TENANT (CNPG, sin VM de PG), techos por namespace.
#
#   aei-stg-1..3   m1.xlarge (8 vCPU / 16 GB / 160 GB root)  Ubuntu 22.04
#                  + volumen cinder 150 GB (/dev/sdb) dedicado a Longhorn
#   red IT911      192.168.0.0/24 (geneve, MTU 1440), router → net4002
#   VIP kube-vip   192.168.0.150 (puerto neutron reservado `aei-stg-vip`,
#                  allowed_address_pairs en los 3 puertos de VM)
#
#   Acceso desde la workstation (VPN → net4002, floating IPs):
#     aei-stg-1  10.40.2.248     aei-stg-2  10.40.2.245     aei-stg-3  10.40.2.220
#     VIP (API)  10.40.2.210  →  192.168.0.150
#
# Uso:
#   ./infra/k3s-ha/deploy-k3s-cluster.sh infra/environments/cotas-staging.env
#   (NO se usa infra/postgres-ha/ en este entorno — ver sección PostgreSQL)
# =============================================================================

ENV_NAME="cotas-staging"

# ─── SSH ─────────────────────────────────────────────────────────────────────
# La keypair OpenStack `pf9_aeisoftware_k3s_vms_id_rsa` del proyecto IT911 es
# la misma clave que .secrets/k3s_rsa (verificado por fingerprint MD5 5f:fc:39…).
SSH_USER="ubuntu"
SSH_KEY="/home/kali/aeisoftware/aei-odoo-saas/.secrets/k3s_rsa"

# ─── Nodos K3s: "name:ssh_ip:internal_ip" (ssh por floating IP) ──────────────
K3S_NODES=(
  "aei-stg-1:10.40.2.248:192.168.0.135"
  "aei-stg-2:10.40.2.245:192.168.0.208"
  "aei-stg-3:10.40.2.220:192.168.0.196"
)
K3S_WORKER_NODES=()             # los 3 servers agendan pods (igual que testbed)
KUBE_VIP_IP="192.168.0.150"
K3S_INTERFACE="ens3"            # virtio OpenStack, MTU 1440 (geneve)

# El cert del API server necesita las floating IPs como SANs para poder usar
# kubectl desde la workstation (que entra por 10.40.2.x, no por 192.168.0.x):
K3S_EXTRA_TLS_SANS="10.40.2.210 10.40.2.248 10.40.2.245 10.40.2.220"
# El kubeconfig descargado apunta a la floating IP del VIP, no al VIP interno:
KUBECONFIG_SERVER_IP="10.40.2.210"

# ─── Storage ─────────────────────────────────────────────────────────────────
# Disco DEDICADO para Longhorn: el volumen cinder de 150 GB (/dev/sdb) se monta
# en /var/lib/longhorn en cada nodo (ver docs/CLOUD-STRATEGY-2026-08.md §2:
# disco dedicado ⇒ minimal-available 10%, storageReserved bajo y explícito,
# réplica 2, overprovisioning 200%, jobs de snapshot-delete + trim).
STORAGE_BACKEND="longhorn"
STORAGE_CLASS="longhorn"
CEPH_MON_HOSTS=""

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# ⚠ NUEVA ARQUITECTURA: NO hay VM/clúster de Postgres en este entorno.
# Cada tenant lleva su propia instancia single (CloudNativePG) DENTRO de su
# namespace — el portal entiende PG_TOPOLOGY=cnpg desde 2026-08-09 (operador
# CNPG 1.30.0 instalado en ns cnpg-system, validado en vivo). El Odoo admin de
# staging usará también una instancia CNPG propia (pendiente, con el stack).
# infra/postgres-ha/deploy-all.sh NO se ejecuta aquí.
PG_TOPOLOGY="cnpg"
PG_NODES=()
PG_ENDPOINT_IPS=""
PG_CHECK_IPS=""
PG_NETWORK_CIDR="192.168.0.0/24"

# ─── Backups S3 ──────────────────────────────────────────────────────────────
# Pendiente: definir object store para backups CNPG (barman-cloud) — opciones:
# MinIO in-cluster, o cotizar object storage de COTAS. Vacío hasta decidirlo.
S3_USE_STUNNEL="false"
S3_REPO_ENDPOINT=""
BACKUP_S3_ENDPOINT=""

# ─── Dominio / ingress ───────────────────────────────────────────────────────
# Desde 2026-08-09 el tunnel comodín *.aeisoftware.com corre AQUÍ (decisión del
# operador: mover el MISMO tunnel del testbed cruzoil, no crear uno nuevo).
# Los connectors de cruzoil quedaron en replicas=0 (rollback fácil). El token
# es el mismo CLOUDFLARE_TUNNEL_TOKEN de siempre (.secrets.env.cotas-staging).
BASE_DOMAIN="aeisoftware.com"
WILDCARD_HOSTNAME="*.aeisoftware.com"
TRAEFIK_SERVICE="http://traefik.kube-system:80"
CF_TUNNEL_ID="afc7a49a-166d-4505-92de-b9aad8fb1e32"
CF_ACCOUNT_ID="2755b41b811dc9afc7396ed5d1e27644"

# ─── Manifiestos a excluir en apply-manifests.sh ─────────────────────────────
MANIFEST_EXCLUDE="05c-portal-servicemonitor.yaml 06-odoo-admin.yaml 06b-odoo-admin-netpol.yaml"
